{
  "name": "student-law-site",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/worker"
  ],
  "scripts": {
    "dev": "npm run dev -w @student-law/web",
    "build": "npm run build -w @student-law/web",
    "start": "npm run start -w @student-law/web",
    "lint": "npm run lint -w @student-law/web && npm run lint -w @student-law/worker",
    "typecheck": "npm run typecheck -w @student-law/web && npm run typecheck -w @student-law/worker",
    "test": "npm run test -w @student-law/web && npm run test -w @student-law/worker",
    "import:sample": "npm run import:sample -w @student-law/worker",
    "ingest:fccp": "npm run ingest:fccp -w @student-law/worker --",
    "review:fccp": "npm run review:fccp -w @student-law/worker --",
    "extract:fccp-text": "npm run extract:fccp-text -w @student-law/worker --",
    "summarize:judgments": "npm run summarize:judgments -w @student-law/worker --",
    "review:summaries": "npm run review:summaries -w @student-law/worker --",
    "ingest:pakistan-code": "npm run ingest:pakistan-code -w @student-law/worker --",
    "review:legislation": "npm run review:legislation -w @student-law/worker --",
    "sync:corpus": "npm run sync:corpus -w @student-law/worker --",
    "test:local": "node --env-file=apps/web/.env.local --env-file=apps/worker/.env scripts/check-local.mjs",
    "test:ingestion-local": "node --env-file=apps/web/.env.local --env-file=apps/worker/.env scripts/check-ingestion-local.mjs",
    "test:phase5-local": "node --env-file=apps/web/.env.local --env-file=apps/worker/.env scripts/check-phase5-local.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@types/node": "22.20.1",
    "playwright-core": "1.65.1",
    "supabase": "2.116.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "5.1.1"
  }
}
