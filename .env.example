# Copy to apps/web/.env.local. Local values come from `npx supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-anon-key
# Optional. Shown on /about and /privacy; set before public launch.
NEXT_PUBLIC_SUPPORT_EMAIL=
# Optional. `on` returns 503 everywhere except /api/v1/health.
MAINTENANCE_MODE=
