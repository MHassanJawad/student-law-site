# Copy to apps/worker/.env. Never copy the service-role key into the web app environment.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
# Only for `npm run sync:corpus`: the hosted project receiving reviewed corpus records. Secret.
TARGET_SUPABASE_URL=
TARGET_SUPABASE_SERVICE_ROLE_KEY=
