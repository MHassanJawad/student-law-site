# Copy to apps/worker/.env. Never copy the service-role key into the web app environment.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
# Only for `npm run sync:corpus`: the hosted project receiving reviewed corpus records. Secret.
TARGET_SUPABASE_URL=
TARGET_SUPABASE_SERVICE_ROLE_KEY=
# Only for `npm run summarize:judgments`. Any OpenAI-compatible chat API works; defaults are Groq.
# Secret: keep the key only here. Get a free Groq key at https://console.groq.com/keys
SUMMARY_API_KEY=
SUMMARY_API_URL=https://api.groq.com/openai/v1/chat/completions
SUMMARY_MODEL=openai/gpt-oss-120b
